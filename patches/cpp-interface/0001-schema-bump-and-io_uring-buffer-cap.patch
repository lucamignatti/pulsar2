 /// @brief Socket buffer large enough to hold at least 4 messages
 constexpr auto SOCKET_BUFFER_SIZE = 4 * (std::numeric_limits<std::uint16_t>::max () + 1u);
 
-constexpr auto PREALLOCATED_BUFFERS = 32;
+// Each registered buffer is BUFFER_SIZE (128 KB) of io_uring PINNED memory, charged
+// against RLIMIT_MEMLOCK (8 MB hard cap here, shared per-user, un-raisable without root).
+// At 32 that is 4 MB/bot, so only ONE bot could register before "Cannot allocate memory"
+// - which broke 2v2/3v3 (every extra Pulsar2 process failed to connect). 4 buffers = 512
+// KB/bot, so ~16 bots fit; a single 15 Hz bot with tiny packets needs nowhere near 32.
+constexpr auto PREALLOCATED_BUFFERS = 4;
 
